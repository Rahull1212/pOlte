generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

// Three-tier role model. "Area" (which Region a SUPER_ADMIN/ADMIN manages) is
// expressed by User.regionId, not by the role itself — an ADMIN's regionId
// can point at a District, Constituency, Mandal, or Booth node interchangeably.
enum Role {
  SUPER_ADMIN
  ADMIN
  CADRE
}

enum RegionType {
  STATE
  DISTRICT
  CONSTITUENCY
  MANDAL
  BOOTH
}

enum CampaignStatus {
  DRAFT
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CampaignPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ExpenseType {
  POSTER_PRINTING
  FOOD
  TRAVEL
  FUEL
  VENUE
  MISCELLANEOUS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  PDF
  VOICE_NOTE
}

enum NotificationType {
  NEW_CAMPAIGN
  TASK_ASSIGNED
  BUDGET_APPROVED
  EXPENSE_REJECTED
  DEADLINE_REMINDER
  CAMPAIGN_COMPLETED
  ESCALATION
  GRIEVANCE_SUBMITTED
  GRIEVANCE_RESOLVED
  EVENT_INVITATION
}

enum AIInsightType {
  SUMMARY
  RISK
  RECOMMENDATION
  PREDICTION
  WEEKLY_REPORT
}

enum GrievanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

// ============================================================
// IDENTITY & HIERARCHY
// ============================================================

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         Role
  regionId     String
  region       Region   @relation(fields: [regionId], references: [id])
  parentUserId String?
  parent       User?    @relation("UserHierarchy", fields: [parentUserId], references: [id])
  children     User[]   @relation("UserHierarchy")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  createdCampaigns    Campaign[]         @relation("CampaignCreator")
  allocationsGiven    TargetAllocation[] @relation("AllocationAssignedBy")
  allocationsOwned    TargetAllocation[] @relation("AllocationOwner")
  tasksAssignedTo     Task[]             @relation("TaskAssignee")
  tasksAssignedBy     Task[]             @relation("TaskAssigner")
  progressUpdates     ProgressUpdate[]
  expenseRequests     ExpenseRequest[]   @relation("ExpenseSubmitter")
  expenseApprovals    ExpenseRequest[]   @relation("ExpenseApprover")
  announcements       Announcement[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  citizensRegistered  Citizen[]          @relation("CitizenRegisteredBy")
  grievancesSubmitted Grievance[]        @relation("GrievanceSubmitter")
  grievancesResolved  Grievance[]        @relation("GrievanceResolver")
  eventsCreated       Event[]            @relation("EventCreator")
  eventParticipation  EventParticipant[]
  whatsAppSession     WhatsAppSession?
}

// Tracks where a Cadre is in the WhatsApp conversation flow (main menu,
// mid-way through registering a citizen, awaiting a progress %, ...) so a
// stateless webhook can resume a multi-step exchange across messages.
model WhatsAppSession {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  state     String   @default("MAIN")
  context   Json?
  updatedAt DateTime @updatedAt
}

model Region {
  id       String     @id @default(cuid())
  name     String
  type     RegionType
  parentId String?
  parent   Region?    @relation("RegionHierarchy", fields: [parentId], references: [id])
  children Region[]   @relation("RegionHierarchy")

  users       User[]
  allocations TargetAllocation[]
  citizens    Citizen[]
  grievances  Grievance[]
  events      Event[]
}

// ============================================================
// CAMPAIGN
// ============================================================

model Campaign {
  id                 String           @id @default(cuid())
  name               String
  description        String
  objective          String?
  category           String?
  startDate          DateTime
  endDate            DateTime
  priority           CampaignPriority @default(MEDIUM)
  status             CampaignStatus   @default(DRAFT)
  bannerUrl          String?
  totalTarget        Int
  totalBudget        Decimal          @db.Decimal(14, 2)
  expectedVolunteers Int?
  requiredDocuments  String[]
  createdById        String
  createdBy          User             @relation("CampaignCreator", fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  attachments   CampaignAttachment[]
  allocations   TargetAllocation[]
  tasks         Task[]
  expenses      ExpenseRequest[]
  announcements Announcement[]
  aiInsights    AIInsight[]

  @@index([status, priority])
}

model CampaignAttachment {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  url        String
  fileType   String
  uploadedAt DateTime @default(now())
}

// Hierarchical target + budget split: State -> District -> Mandal -> Booth -> Cadre.
// Each row's parentAllocationId points to the allocation it was split from,
// so the tree mirrors the org hierarchy exactly.
model TargetAllocation {
  id                 String            @id @default(cuid())
  campaignId         String
  campaign           Campaign          @relation(fields: [campaignId], references: [id])
  regionId           String
  region             Region            @relation(fields: [regionId], references: [id])
  ownerUserId        String
  ownerUser          User              @relation("AllocationOwner", fields: [ownerUserId], references: [id])
  assignedById       String
  assignedBy         User              @relation("AllocationAssignedBy", fields: [assignedById], references: [id])
  parentAllocationId String?
  parentAllocation   TargetAllocation? @relation("AllocationHierarchy", fields: [parentAllocationId], references: [id])
  childAllocations   TargetAllocation[] @relation("AllocationHierarchy")

  target        Int
  achievedCount Int      @default(0)
  deadline      DateTime
  notes         String?

  allocatedBudget Decimal @db.Decimal(14, 2)
  approvedBudget  Decimal @db.Decimal(14, 2) @default(0)
  spentBudget     Decimal @db.Decimal(14, 2) @default(0)
  // remainingBudget = allocatedBudget - spentBudget, computed in the service layer

  createdAt DateTime @default(now())

  tasks    Task[]
  expenses ExpenseRequest[]

  @@index([campaignId, regionId])
}

// ============================================================
// TASKS & PROGRESS
// ============================================================

model Task {
  id           String            @id @default(cuid())
  campaignId   String
  campaign     Campaign          @relation(fields: [campaignId], references: [id])
  allocationId String?
  allocation   TargetAllocation? @relation(fields: [allocationId], references: [id])
  name         String
  description  String?
  assignedToId String
  assignedTo   User              @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User              @relation("TaskAssigner", fields: [assignedById], references: [id])
  deadline     DateTime
  priority     TaskPriority      @default(MEDIUM)
  status       TaskStatus        @default(PENDING)
  remarks      String?
  createdAt    DateTime          @default(now())

  attachments TaskAttachment[]
  progress    ProgressUpdate[]

  @@index([assignedToId, status])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  url       String
  fileType  String
  createdAt DateTime @default(now())
}

model ProgressUpdate {
  id                   String   @id @default(cuid())
  taskId               String
  task                 Task     @relation(fields: [taskId], references: [id])
  cadreId              String
  cadre                User     @relation(fields: [cadreId], references: [id])
  completedForms       Int?
  meetingsConducted    Int?
  houseVisits          Int?
  volunteersJoined     Int?
  photos               String[]
  videos               String[]
  gpsLat               Float?
  gpsLng               Float?
  completionPercentage Int
  createdAt            DateTime @default(now())
}

// ============================================================
// BUDGET & EXPENSES
// ============================================================

model ExpenseRequest {
  id              String            @id @default(cuid())
  campaignId      String
  campaign        Campaign          @relation(fields: [campaignId], references: [id])
  allocationId    String?
  allocation      TargetAllocation? @relation(fields: [allocationId], references: [id])
  submittedById   String
  submittedBy     User              @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  expenseType     ExpenseType
  amount          Decimal           @db.Decimal(12, 2)
  billUrl         String?
  description     String?
  approvalStatus  ApprovalStatus    @default(PENDING)
  approvedById    String?
  approvedBy      User?             @relation("ExpenseApprover", fields: [approvedById], references: [id])
  rejectionReason String?
  createdAt       DateTime          @default(now())
  decidedAt       DateTime?

  @@index([campaignId, approvalStatus])
}

// ============================================================
// COMMUNICATION & NOTIFICATIONS
// ============================================================

model Announcement {
  id              String           @id @default(cuid())
  campaignId      String?
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])
  senderId        String
  sender          User             @relation(fields: [senderId], references: [id])
  targetLevels    Role[]
  targetRegionIds String[]
  messageType     MessageType
  content         String
  mediaUrl        String?
  createdAt       DateTime         @default(now())
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  type              NotificationType
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean          @default(false)
  createdAt         DateTime         @default(now())

  @@index([userId, isRead])
}

// ============================================================
// AI & AUDIT
// ============================================================

model AIInsight {
  id          String        @id @default(cuid())
  campaignId  String
  campaign    Campaign      @relation(fields: [campaignId], references: [id])
  type        AIInsightType
  regionId    String?
  content     String
  metadata    Json?
  generatedAt DateTime      @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ============================================================
// CITIZEN REGISTRATION & GRIEVANCES
// ============================================================
// Citizens are data records maintained by Cadres/Admins — citizens never
// log into the platform themselves. There is no citizen-facing surface.

model Citizen {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  address        String?
  regionId       String
  region         Region   @relation(fields: [regionId], references: [id])
  registeredById String
  registeredBy   User     @relation("CitizenRegisteredBy", fields: [registeredById], references: [id])
  createdAt      DateTime @default(now())

  grievances Grievance[]

  @@index([regionId])
}

model Grievance {
  id              String          @id @default(cuid())
  citizenId       String
  citizen         Citizen         @relation(fields: [citizenId], references: [id])
  regionId        String
  region          Region          @relation(fields: [regionId], references: [id])
  submittedById   String
  submittedBy     User            @relation("GrievanceSubmitter", fields: [submittedById], references: [id])
  category        String
  description     String
  photos          String[]
  status          GrievanceStatus @default(OPEN)
  resolutionNotes String?
  resolvedById    String?
  resolvedBy      User?           @relation("GrievanceResolver", fields: [resolvedById], references: [id])
  createdAt       DateTime        @default(now())
  resolvedAt      DateTime?

  @@index([regionId, status])
}

// ============================================================
// EVENTS & ATTENDANCE
// ============================================================

model Event {
  id          String    @id @default(cuid())
  name        String
  description String?
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id])
  startAt     DateTime
  endAt       DateTime?
  createdById String
  createdBy   User      @relation("EventCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  participants EventParticipant[]

  @@index([regionId, startAt])
}

model EventParticipant {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  attended    Boolean   @default(false)
  checkedInAt DateTime?

  @@unique([eventId, userId])
}
