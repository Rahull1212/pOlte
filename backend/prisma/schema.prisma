generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

// Three-tier role model. "Area" (which Region a SUPER_ADMIN/ADMIN manages) is
// expressed by User.regionId, not by the role itself — an ADMIN's regionId
// can point at a District, Constituency, or Polling Station node interchangeably.
enum Role {
  SUPER_ADMIN
  ADMIN
  CADRE
}

// The Election Commission's own hierarchy, and nothing else: a State holds
// Districts, a District holds Assembly Constituencies, and an AC holds
// Polling Stations (BOOTH). Mandals were dropped — they are a revenue
// administrative unit that appears nowhere in electoral rolls, so a task
// located by Mandal could not be tied back to an official polling station.
enum RegionType {
  STATE
  DISTRICT
  CONSTITUENCY
  BOOTH
}

enum CampaignStatus {
  DRAFT
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

// Where an Admin stands on a campaign they were assigned. A Super Admin
// creates a campaign and hands it to Admins; until an Admin ACCEPTS, they
// have taken on no work and may not allocate any of it to their Cadres.
enum CampaignAssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum CampaignPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskAcknowledgment {
  AWAITING
  ACCEPTED
  DECLINED
}

enum TaskCompletionConfirmation {
  AWAITING
  YES
  NO
}

enum ExpenseType {
  POSTER_PRINTING
  FOOD
  TRAVEL
  FUEL
  VENUE
  MISCELLANEOUS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  PDF
  VOICE_NOTE
}

enum NotificationType {
  NEW_CAMPAIGN
  TASK_ASSIGNED
  BUDGET_APPROVED
  EXPENSE_REJECTED
  DEADLINE_REMINDER
  CAMPAIGN_COMPLETED
  ESCALATION
  GRIEVANCE_SUBMITTED
  GRIEVANCE_RESOLVED
  EVENT_INVITATION
  TASK_DECLINED
  TASK_PENDING_ALLOCATION
  TASK_ALLOCATED
  POLL_PENDING_ALLOCATION
}

enum AIInsightType {
  SUMMARY
  RISK
  RECOMMENDATION
  PREDICTION
  WEEKLY_REPORT
}

enum GrievanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum OtpPurpose {
  PHONE_CHANGE
  PASSWORD_RESET
}

// ============================================================
// IDENTITY & HIERARCHY
// ============================================================

model User {
  id             String   @id @default(cuid())
  name           String
  phone          String   @unique
  email          String?  @unique
  passwordHash   String
  role           Role
  gender         Gender?
  profilePicture String?
  regionId       String
  region         Region   @relation(fields: [regionId], references: [id])
  parentUserId   String?
  parent         User?    @relation("UserHierarchy", fields: [parentUserId], references: [id])
  children       User[]   @relation("UserHierarchy")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  // Stamped by AuthService.login. Null means "never signed in" — which for
  // a Cadre is normal (they live entirely in WhatsApp), but for an Admin
  // handed a web account it is the single most useful thing on their
  // profile: it says whether the account was ever actually picked up.
  lastLoginAt    DateTime?

  // The approved WhatsApp template this user's OWN tasks go out with,
  // assigned by a Super Admin (see MessageTemplatesService). One template per
  // person, but the SAME template may be shared by any number of them —
  // a campaign typically has far more Admins than approved templates, so
  // requiring one each would leave most Admins unable to have one at all.
  // Null is the norm rather than an error: TasksService falls back to the
  // default "polios" template.
  //
  // PoliOS can't create or approve these — the name must already exist and
  // be approved in Fyxo/Meta. Body is recorded only so the message log and
  // the UI can show what the Cadre actually reads; it is never sent.
  // How many variables a template takes comes from the synced catalogue;
  // what goes in each is fyxoTemplateVariables below.
  fyxoTemplateName     String?
  fyxoTemplateLanguage String?
  fyxoTemplateBody     String?
  // What each {{n}} placeholder is filled with, in order — one token per
  // variable the template declares (CADRE_NAME, TASK_NAME, DEADLINE,
  // PRIORITY, ASSIGNED_BY). Chosen by the Super Admin when they assign the
  // template, because only they know what the approved wording expects in
  // each slot. Empty falls back to the conventional who/what/when order.
  fyxoTemplateVariables String[]
  // What each Quick Reply on that template replies with when a Cadre taps
  // it: [{ label, action, text? }], one entry per button in the approved
  // template's own order.
  //
  // JSON rather than a table because it is a small, always-read-together
  // settings blob owned by exactly one user — a row per button would add a
  // join to every send path for no query anyone runs. `action` is one of
  // ButtonReplyAction (see shared-types); `text` carries the wording for a
  // CUSTOM_TEXT reply.
  fyxoTemplateButtons   Json?

  createdCampaigns    Campaign[]         @relation("CampaignCreator")
  campaignsAssigned   CampaignAdmin[]    @relation("CampaignAssignedAdmin")
  allocationsGiven    TargetAllocation[] @relation("AllocationAssignedBy")
  allocationsOwned    TargetAllocation[] @relation("AllocationOwner")
  tasksAssignedTo     Task[]             @relation("TaskAssignee")
  tasksAssignedBy     Task[]             @relation("TaskAssigner")
  taskBatchesCreated  TaskBatch[]
  progressUpdates     ProgressUpdate[]
  expenseRequests     ExpenseRequest[]   @relation("ExpenseSubmitter")
  expenseApprovals    ExpenseRequest[]   @relation("ExpenseApprover")
  announcements       Announcement[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  citizensRegistered  Citizen[]          @relation("CitizenRegisteredBy")
  grievancesSubmitted Grievance[]        @relation("GrievanceSubmitter")
  grievancesResolved  Grievance[]        @relation("GrievanceResolver")
  eventsCreated       Event[]            @relation("EventCreator")
  eventParticipation  EventParticipant[]
  whatsAppSession     WhatsAppSession?
  otpCodes            OtpCode[]
  bulkCampaignsCreated BulkMessageCampaign[]
  fieldReports        FieldReport[]      @relation("FieldReportCadre")
  pollsCreated        Poll[]             @relation("PollCreator")
  pollResponses       PollRecipient[]    @relation("PollRecipientCadre")
  messagesReceived    TaskMessageLog[]   @relation("MessageLogCadre")
  templateResponses   TemplateResponse[] @relation("TemplateResponseCadre")
  messagesSent        TaskMessageLog[]   @relation("MessageLogAssignedBy")
}

// Verification codes for self-service flows that need proof the caller
// controls a phone number: changing to a new number, and resetting a
// forgotten password. Codes are hashed at rest (never stored plaintext),
// short-lived, single-use, and attempt-limited to resist brute force.
model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose, phone])
}

// Tracks where a Cadre is in the WhatsApp conversation flow (main menu,
// mid-way through registering a citizen, awaiting a progress %, ...) so a
// stateless webhook can resume a multi-step exchange across messages.
model WhatsAppSession {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  state     String   @default("MAIN")
  context   Json?
  updatedAt DateTime @updatedAt
}

model Region {
  id       String     @id @default(cuid())
  name     String
  // The official ECI number: the Assembly Constituency number for a
  // CONSTITUENCY ("55"), the Polling Station number for a BOOTH ("142",
  // "12A"). Free text, not an Int: real numbers carry letters and leading
  // zeros. States and Districts have none, so it's optional — and it is
  // unique among siblings, not globally, since every AC numbers its polling
  // stations from 1.
  number   String?
  type     RegionType
  parentId String?
  parent   Region?    @relation("RegionHierarchy", fields: [parentId], references: [id])
  children Region[]   @relation("RegionHierarchy")

  users          User[]
  allocations    TargetAllocation[]
  citizens       Citizen[]
  grievances     Grievance[]
  events         Event[]
  bulkRecipients BulkRecipient[]
  tasks          Task[]             @relation("TaskPollingStation")
  taskBatches    TaskBatch[]        @relation("TaskBatchPollingStation")
}

// ============================================================
// CAMPAIGN
// ============================================================

model Campaign {
  id                 String           @id @default(cuid())
  name               String
  description        String
  objective          String?
  category           String?
  startDate          DateTime
  endDate            DateTime
  priority           CampaignPriority @default(MEDIUM)
  status             CampaignStatus   @default(DRAFT)
  bannerUrl          String?
  // Optional headline figures. A campaign can be created without declaring
  // an overall target or budget — those are allocated per area on the
  // Targets/Budget screens, which is where the numbers that matter live.
  // Null means "none declared", and AllocationsService then applies no cap.
  totalTarget        Int?
  // What one unit of `totalTarget` IS — "Membership forms", "House visits".
  // Stored on the campaign so every allocation and every progress report
  // beneath it counts the same thing; without it a campaign could reach
  // "500 of 500" by adding 300 house visits to 200 forms.
  targetMetric       String?
  totalBudget        Decimal?         @db.Decimal(14, 2)
  expectedVolunteers Int?
  requiredDocuments  String[]
  createdById        String
  createdBy          User             @relation("CampaignCreator", fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  attachments   CampaignAttachment[]
  allocations   TargetAllocation[]
  tasks         Task[]
  taskBatches   TaskBatch[]
  expenses      ExpenseRequest[]
  announcements Announcement[]
  aiInsights    AIInsight[]
  assignedAdmins CampaignAdmin[]

  @@index([status, priority])
}

// Which Admins are responsible for a campaign, chosen when it's created.
// A join table rather than a field on either side: a campaign runs across
// several Admins' areas, and an Admin works on several campaigns at once —
// neither direction is single-valued.
model CampaignAdmin {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adminId    String
  admin      User     @relation("CampaignAssignedAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  // The Admin's own answer to being given this campaign. Assignment alone
  // isn't agreement: an Admin who hasn't accepted may look at the campaign
  // but cannot allocate its work to their Cadres (TasksService gates on
  // this), so nobody is quietly made responsible for a campaign they never
  // took on.
  status      CampaignAssignmentStatus @default(PENDING)
  respondedAt DateTime?
  // Why they declined, or any note on accepting. Shown to the Super Admin,
  // who otherwise only learns that someone said no, not why.
  responseNote String?

  // One row per (campaign, admin): assigning the same Admin twice is a
  // no-op rather than a duplicate.
  @@id([campaignId, adminId])
  @@index([adminId])
  @@index([adminId, status])
}

model CampaignAttachment {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  url        String
  fileType   String
  uploadedAt DateTime @default(now())
}

// Hierarchical target + budget split: State -> District -> Constituency -> Polling Station -> Cadre.
// Each row's parentAllocationId points to the allocation it was split from,
// so the tree mirrors the org hierarchy exactly.
model TargetAllocation {
  id                 String             @id @default(cuid())
  campaignId         String
  campaign           Campaign           @relation(fields: [campaignId], references: [id])
  regionId           String
  region             Region             @relation(fields: [regionId], references: [id])
  ownerUserId        String
  ownerUser          User               @relation("AllocationOwner", fields: [ownerUserId], references: [id])
  assignedById       String
  assignedBy         User               @relation("AllocationAssignedBy", fields: [assignedById], references: [id])
  parentAllocationId String?
  parentAllocation   TargetAllocation?  @relation("AllocationHierarchy", fields: [parentAllocationId], references: [id])
  childAllocations   TargetAllocation[] @relation("AllocationHierarchy")

  target        Int
  achievedCount Int      @default(0)
  deadline      DateTime
  notes         String?

  allocatedBudget Decimal @db.Decimal(14, 2)
  approvedBudget  Decimal @default(0) @db.Decimal(14, 2)
  spentBudget     Decimal @default(0) @db.Decimal(14, 2)
  // remainingBudget = allocatedBudget - spentBudget, computed in the service layer

  createdAt DateTime @default(now())

  tasks    Task[]
  expenses ExpenseRequest[]

  @@index([campaignId, regionId])
}

// ============================================================
// TASKS & PROGRESS
// ============================================================

// One "Create Task" submission that fans out to every Cadre under the
// selected District(s)/Constituency(s)/Polling Station(s) — one Task row per resolved
// Cadre (see TasksService.createBatch), grouped here so the Task
// Intelligence Dashboard can show rollup stats without a single Task
// trying to represent more than one assignee.
model TaskBatch {
  id                String       @id @default(cuid())
  name              String
  objective         String?
  description       String?
  remarks           String?
  deadline          DateTime
  priority          TaskPriority @default(MEDIUM)
  campaignId        String?
  campaign          Campaign?    @relation(fields: [campaignId], references: [id])
  // The official ECI location this work belongs to: a BOOTH (polling
  // station), whose ancestry gives the Assembly Constituency, District and
  // State. Optional so a batch that spans several ACs can still be created.
  pollingStationId  String?
  pollingStation    Region?      @relation("TaskBatchPollingStation", fields: [pollingStationId], references: [id])
  targetRegionIds   String[] // the District/Constituency/Polling Station selection, kept for audit/display
  attachmentUrls    String[]
  createdById       String
  createdBy         User         @relation(fields: [createdById], references: [id])
  createdAt         DateTime     @default(now())
  // True only for a SUPER_ADMIN-created batch: no Task rows are created yet —
  // it's routed to whichever Admins cover targetRegionIds, and each Admin
  // allocates it to their own Cadres (TasksService.allocateToCadres), which
  // is what actually creates the Task rows below. An ADMIN-created batch
  // fans out to Cadres immediately, same as before, so this stays false.
  awaitingAllocation Boolean     @default(false)

  tasks      Task[]
  aiInsights AIInsight[]

  @@index([pollingStationId])
}

enum WhatsappDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Task {
  id                String                 @id @default(cuid())
  campaignId        String?
  campaign          Campaign?              @relation(fields: [campaignId], references: [id])
  allocationId      String?
  allocation        TargetAllocation?      @relation(fields: [allocationId], references: [id])
  batchId           String?
  batch             TaskBatch?             @relation(fields: [batchId], references: [id])
  // The official ECI location this task is carried out at — a BOOTH
  // (polling station). Its ancestry supplies the Assembly Constituency,
  // District and State shown on the task, so those four facts can never
  // drift out of agreement with each other.
  pollingStationId  String?
  pollingStation    Region?                @relation("TaskPollingStation", fields: [pollingStationId], references: [id])
  name              String
  objective         String?
  description       String?
  assignedToId      String
  assignedTo        User                   @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedById      String
  assignedBy        User                   @relation("TaskAssigner", fields: [assignedById], references: [id])
  deadline          DateTime
  priority          TaskPriority           @default(MEDIUM)
  status            TaskStatus             @default(PENDING)
  remarks           String?
  acknowledgment    TaskAcknowledgment     @default(AWAITING)
  acknowledgedAt    DateTime?
  needsReassignment Boolean                @default(false)
  // Per-Cadre WhatsApp delivery outcome for this allocation — set when
  // allocateToCadres() sends the assignment message, retried independently
  // via retryWhatsapp() if it failed. Deliberately lives on Task (one row
  // per assigned Cadre) rather than a separate table, since Task already
  // *is* the per-Cadre allocation record. whatsappMessageId correlates
  // Meta's delivered/read status webhook callbacks back to this row (see
  // WhatsAppWebhookController + TasksService.handleWhatsappStatusUpdate).
  whatsappStatus    WhatsappDeliveryStatus @default(PENDING)
  whatsappMessageId String?
  // Correlates a Fyxo-sent interactive assignment message's delivery-status
  // webhook back to this row — distinct from whatsappMessageId (Meta's
  // wamid) since a Task can only have been sent through one channel or the
  // other for its assignment message, never both (see NotificationsService).
  fyxoMessageId     String?
  // Which Fyxo template the assignment message actually went out as (e.g.
  // "polios") — kept alongside fyxoMessageId so a later webhook-driven
  // interaction (a button tap) can be traced back to exactly what was sent,
  // and so this stays meaningful once more than one approved template exists.
  fyxoTemplateName  String?
  whatsappSentAt    DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  // First time this Task's progress hit 100% — set once, kept stable across
  // any later re-submission, so "average completion time" reflects the
  // actual first completion rather than a resubmit timestamp.
  completedAt       DateTime?
  // "Have you completed your task?" Yes/No check-in — distinct from
  // `acknowledgment` above (that's "will you take this on"; this is "did
  // you finish it"). Only set once an Admin actually sends the check-in
  // (see TasksService.sendCompletionCheck) — most tasks are never asked, so
  // completionConfirmation being null means "never asked", not "asked but
  // no reply yet" (that's AWAITING). Its own message id, separate from
  // fyxoMessageId above, since a Task can have two different outbound Fyxo
  // sends (the original assignment, and later this check-in) needing to
  // correlate independently against their own delivery-status webhooks.
  completionCheckSentAt        DateTime?
  completionCheckFyxoMessageId String?
  completionConfirmation       TaskCompletionConfirmation?
  completionConfirmedAt        DateTime?
  createdAt         DateTime               @default(now())

  attachments  TaskAttachment[]
  progress     ProgressUpdate[]
  fieldReports FieldReport[]
  messageLog   TaskMessageLog[]
  polls        Poll[]
  responses    TemplateResponse[]

  @@index([assignedToId, status])
  @@index([whatsappMessageId])
  @@index([fyxoMessageId])
  @@index([pollingStationId])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  url       String
  fileType  String
  createdAt DateTime @default(now())
}

// ============================================================
// POLLS
// ============================================================
// Same two-step "create the record, then allocate/send it" shape as
// TaskBatch/Task (see PollsService) — created with awaitingAllocation:
// true and zero recipients, sent only once explicitly allocated to
// Cadres. Delivered via a generic Fyxo template with fixed Quick Reply
// buttons (Meta template buttons can't carry per-poll dynamic text) — the
// question and option *labels* go in the message body as variables, and
// the buttons are just generic slots ("Option A/B/C") whose tap gets
// mapped back to this poll's real options by position. See
// FYXO_TEMPLATES.POLL and PollsService.allocate.
model Poll {
  id                 String    @id @default(cuid())
  question           String
  // The answers, as the Cadre sees them. No longer typed by hand: they are
  // the Quick Reply buttons of `templateName`, copied here at create time so
  // a poll still reads correctly if that template is later changed or
  // un-approved. Empty only for polls created before templates were used.
  options            String[]
  // The approved WhatsApp template this poll is asked with. Its buttons ARE
  // the options — WhatsApp fixes button labels at approval time, so the way
  // to offer "Yes / No" is to pick a template whose buttons say that.
  templateName       String?
  templateLanguage   String?
  // A poll can stand alone or hang off a task ("did you finish this?").
  // Null means standalone.
  taskId             String?
  task               Task?     @relation(fields: [taskId], references: [id])
  targetRegionIds    String[]
  deadline           DateTime?
  createdById        String
  createdBy          User      @relation("PollCreator", fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  awaitingAllocation Boolean   @default(true)

  recipients  PollRecipient[]
  messageLogs TaskMessageLog[]

  @@index([taskId])
}

enum PollRecipientStatus {
  PENDING
  SENT
  FAILED
  ANSWERED
}

// One row per Cadre a Poll was sent to — mirrors Task's one-row-per-Cadre
// shape. cadreId is optional so a response's vote survives that Cadre's
// account being deleted later (see UsersService.remove) without
// misattributing it to whoever did the deleting.
model PollRecipient {
  id             String              @id @default(cuid())
  pollId         String
  poll           Poll                @relation(fields: [pollId], references: [id])
  cadreId        String?
  cadre          User?               @relation("PollRecipientCadre", fields: [cadreId], references: [id])
  status         PollRecipientStatus @default(PENDING)
  fyxoMessageId  String?
  sentAt         DateTime?
  // Index into the Poll's options array — recorded once the webhook-driven
  // button-tap correlation is confirmed and wired (not yet — see
  // PollsService's doc comment).
  selectedOption Int?
  answeredAt     DateTime?
  createdAt      DateTime            @default(now())

  @@index([pollId])
  @@index([fyxoMessageId])
}

model ProgressUpdate {
  id                   String   @id @default(cuid())
  taskId               String
  task                 Task     @relation(fields: [taskId], references: [id])
  // Optional (not required) so a field report survives its Cadre being
  // deleted — the report content is real field data, not the deleted
  // account's property, and reassigning it to whoever did the deleting
  // would misattribute who actually did the work. See UsersService.remove().
  cadreId              String?
  cadre                User?    @relation(fields: [cadreId], references: [id])
  // How much MORE was done since the last report, in the campaign's own
  // metric. Incremental by design: the old fields below were read as running
  // totals, so reporting "5" then "3" produced a delta of -2 and the achieved
  // count went backwards.
  unitsCompleted       Int?
  // Legacy per-activity counters, kept so existing reports still read. New
  // reports use unitsCompleted.
  completedForms       Int?
  meetingsConducted    Int?
  houseVisits          Int?
  volunteersJoined     Int?
  photos               String[]
  videos               String[]
  gpsLat               Float?
  gpsLng               Float?
  completionPercentage Int
  createdAt            DateTime @default(now())
}

// ============================================================
// BUDGET & EXPENSES
// ============================================================

model ExpenseRequest {
  id              String            @id @default(cuid())
  campaignId      String
  campaign        Campaign          @relation(fields: [campaignId], references: [id])
  allocationId    String?
  allocation      TargetAllocation? @relation(fields: [allocationId], references: [id])
  submittedById   String
  submittedBy     User              @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  expenseType     ExpenseType
  amount          Decimal           @db.Decimal(12, 2)
  billUrl         String?
  description     String?
  approvalStatus  ApprovalStatus    @default(PENDING)
  approvedById    String?
  approvedBy      User?             @relation("ExpenseApprover", fields: [approvedById], references: [id])
  rejectionReason String?
  createdAt       DateTime          @default(now())
  decidedAt       DateTime?

  @@index([campaignId, approvalStatus])
}

// ============================================================
// COMMUNICATION & NOTIFICATIONS
// ============================================================

model Announcement {
  id              String      @id @default(cuid())
  campaignId      String?
  campaign        Campaign?   @relation(fields: [campaignId], references: [id])
  senderId        String
  sender          User        @relation(fields: [senderId], references: [id])
  targetLevels    Role[]
  targetRegionIds String[]
  messageType     MessageType
  content         String
  mediaUrl        String?
  createdAt       DateTime    @default(now())
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  type              NotificationType
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean          @default(false)
  createdAt         DateTime         @default(now())

  @@index([userId, isRead])
}

// ============================================================
// BULK WHATSAPP MESSAGING (via Fyxo Connect)
// ============================================================

enum BulkCampaignStatus {
  DRAFT // recipients uploaded, message/selection still being set up
  SENDING // dispatch calls to Fyxo Connect in progress
  SENT // every selected recipient has been handed off to Fyxo Connect
  FAILED // the dispatch call to Fyxo Connect failed outright
}

enum BulkRecipientStatus {
  PENDING // selected, not yet dispatched
  SENT // handed off to Fyxo Connect
  DELIVERED
  READ
  FAILED
  OPTED_OUT
}

// One Excel upload = one campaign. Recipients are parsed once at upload
// time (see BulkMessagingService.parseAndValidate) and never re-derived —
// this row tracks the message content and roll-up counts; BulkRecipient
// rows below are the actual send list and per-contact delivery state.
model BulkMessageCampaign {
  id             String             @id @default(cuid())
  name           String
  messageText    String?
  mediaUrl       String?
  templateId     String? // optional Fyxo Connect template reference, once that contract is known
  status         BulkCampaignStatus @default(DRAFT)
  totalContacts  Int                @default(0)
  validCount     Int                @default(0)
  invalidCount   Int                @default(0)
  duplicateCount Int                @default(0)
  createdById    String
  createdBy      User               @relation(fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  sentAt         DateTime?

  recipients BulkRecipient[]

  @@index([status])
}

// One row per Excel row. District/Constituency/Polling Station are kept as the
// raw text from the file (source of truth for filtering — an uploaded
// contact list won't always match Region spelling exactly) AND
// best-effort-resolved against the real Region table into regionId, so a
// row that does match gets the benefit of the real hierarchy where useful.
model BulkRecipient {
  id                String               @id @default(cuid())
  campaignId        String
  campaign          BulkMessageCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name              String?
  phone             String // normalized, digits-only
  rawPhone          String // exactly as uploaded, for audit/debugging
  districtName      String?
  constituencyName  String?
  boothName         String?
  regionId          String?
  region            Region?              @relation(fields: [regionId], references: [id])
  isValidPhone      Boolean              @default(true)
  isDuplicate       Boolean              @default(false)
  selected          Boolean              @default(true)
  status            BulkRecipientStatus  @default(PENDING)
  providerMessageId String? // Fyxo Connect's id for this send, for webhook correlation
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedReason      String?
  createdAt         DateTime             @default(now())

  @@index([campaignId, status])
  @@index([campaignId, selected])
  @@index([providerMessageId])
}

// ============================================================
// AI & AUDIT
// ============================================================

model AIInsight {
  id          String        @id @default(cuid())
  campaignId  String?
  campaign    Campaign?     @relation(fields: [campaignId], references: [id])
  taskBatchId String?
  taskBatch   TaskBatch?    @relation(fields: [taskBatchId], references: [id])
  type        AIInsightType
  regionId    String?
  content     String
  metadata    Json?
  generatedAt DateTime      @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  // Optional so an audit entry survives its actor being deleted — an audit
  // log records a historical fact about who did something; reassigning
  // that FK to whoever performed the deletion would falsify the record
  // instead of preserving it. See UsersService.remove().
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ============================================================
// CITIZEN REGISTRATION & GRIEVANCES
// ============================================================
// Citizens are data records maintained by Cadres/Admins — citizens never
// log into the platform themselves. There is no citizen-facing surface.

model Citizen {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  address        String?
  regionId       String
  region         Region   @relation(fields: [regionId], references: [id])
  registeredById String
  registeredBy   User     @relation("CitizenRegisteredBy", fields: [registeredById], references: [id])
  createdAt      DateTime @default(now())

  grievances Grievance[]

  @@index([regionId])
}

model Grievance {
  id              String          @id @default(cuid())
  citizenId       String?
  citizen         Citizen?        @relation(fields: [citizenId], references: [id])
  regionId        String
  region          Region          @relation(fields: [regionId], references: [id])
  submittedById   String
  submittedBy     User            @relation("GrievanceSubmitter", fields: [submittedById], references: [id])
  // Which role filed this, captured at submission time rather than read back
  // off submittedBy — a Cadre later promoted to Admin must not retroactively
  // change who is recorded as having raised the grievance.
  submittedByRole Role
  category        String
  description     String
  // Evidence attached by the submitter. Was `photos`, but grievances now
  // carry PDFs and Word documents too, so the name matches Task/TaskBatch's
  // `attachmentUrls` rather than claiming everything is an image.
  attachmentUrls  String[]
  status          GrievanceStatus @default(OPEN)
  resolutionNotes String?
  resolvedById    String?
  resolvedBy      User?           @relation("GrievanceResolver", fields: [resolvedById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  resolvedAt      DateTime?

  @@index([regionId, status])
  @@index([submittedById])
}

// ============================================================
// EVENTS & ATTENDANCE
// ============================================================

model Event {
  id                String    @id @default(cuid())
  name              String
  description       String?
  objective         String?
  location          String?
  organizer         String?
  instructions      String?
  remarks           String? // "Comments" on the detail page, and "Event Issues/Remarks" on the dashboard
  expectedAttendees Int?
  attachmentUrls    String[]  @default([])
  regionId          String
  region            Region    @relation(fields: [regionId], references: [id])
  startAt           DateTime
  endAt             DateTime?
  createdById       String
  createdBy         User      @relation("EventCreator", fields: [createdById], references: [id])
  createdAt         DateTime  @default(now())

  participants EventParticipant[]

  @@index([regionId, startAt])
}

enum EventRsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model EventParticipant {
  id          String          @id @default(cuid())
  eventId     String
  event       Event           @relation(fields: [eventId], references: [id])
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  rsvpStatus  EventRsvpStatus @default(PENDING)
  attended    Boolean         @default(false)
  checkedInAt DateTime?

  @@unique([eventId, userId])
}

// ============================================================
// FIELD INTELLIGENCE (WhatsApp/AI agent layer, via Fyxo Connect)
// ============================================================

enum FieldReportSource {
  CADRE_VOICE_REPORT
  CADRE_TEXT_REPORT
  CADRE_PHOTO_REPORT
  CADRE_DOCUMENT_REPORT
}

// SUBMITTED -> NEEDS_REVIEW (low-confidence extraction) or straight to
// VERIFIED once an Admin has looked at it. Deliberately NOT modeled as a
// new Task.status value — Task's existing status/acknowledgment enums are
// read by every dashboard already built; this layers the verification
// workflow on the FieldReport itself instead of widening Task's enum.
enum FieldReportReviewStatus {
  SUBMITTED
  NEEDS_REVIEW
  VERIFIED
}

// One row per piece of unstructured field intelligence (voice/text/photo/
// document) a Cadre sends on WhatsApp, produced by FieldIntelligenceAgent.
// taskId is nullable — a Cadre can send a field report that isn't tied to
// any specific assignment (e.g. an unprompted issue report).
model FieldReport {
  id                 String                   @id @default(cuid())
  taskId             String?
  task               Task?                    @relation(fields: [taskId], references: [id])
  // Optional for the same reason as ProgressUpdate.cadreId — preserve the
  // report itself without misattributing it if the Cadre is later deleted.
  cadreId            String?
  cadre              User?                    @relation("FieldReportCadre", fields: [cadreId], references: [id])
  source             FieldReportSource
  rawMediaUrl        String?
  originalTranscript String?
  detectedLanguage   String?
  normalizedText     String?
  // Structured extraction, e.g. { region, householdsVisited, ... } — shape
  // varies by report content, so JSON rather than fixed columns.
  extractedData      Json?
  // Array of { category, affectedHouseholds?, duration?, confidence, ... }
  issues             Json?
  // Overall extraction confidence (0-1). Individual field confidences live
  // inside extractedData/issues themselves (see Part 16 of the spec).
  confidence         Float?
  reviewStatus       FieldReportReviewStatus @default(SUBMITTED)
  evidenceUrls       String[]                @default([])
  createdAt          DateTime                @default(now())

  @@index([taskId])
  @@index([cadreId])
  @@index([reviewStatus])
}

// What a Cadre did with a template we sent them — a button tap, or a reply.
//
// Nothing recorded an inbound response before this: a template quick-reply
// arrived, the router logged a line, and the tap was gone. Without a stored
// row there is no way to answer "who opened their task and who ignored it",
// which is the whole point of putting buttons on the message.
//
// Deliberately separate from TaskMessageLog (one row per message SENT):
// one message can draw several responses, and a response can arrive with no
// message row to attach to (a Cadre replying out of the blue).
model TemplateResponse {
  id           String          @id @default(cuid())
  // The send this is a response to, when it can be identified. Nullable
  // because a tap on an older message, or a free-text reply, may not
  // correlate to a specific row.
  messageLogId String?
  messageLog   TaskMessageLog? @relation(fields: [messageLogId], references: [id], onDelete: SetNull)
  taskId       String?
  task         Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  cadreId      String?
  cadre        User?           @relation("TemplateResponseCadre", fields: [cadreId], references: [id], onDelete: SetNull)
  // Denormalised so a response survives its Cadre being deleted — the fact
  // that someone responded is history, not the account's property.
  cadreName    String
  cadrePhone   String
  // BUTTON | TEXT — how the Cadre answered.
  responseType String
  // The normalised action: VIEW_TASK, CONTACT_ADMIN, ACCEPT, ... Derived
  // from the button payload we set at send time, so it stays stable even if
  // the button's visible label is reworded in the Meta console later.
  action       String
  // What the button actually said, or the text they typed. Kept verbatim
  // because it is what the person saw and chose.
  label        String?
  // The raw payload/text as it arrived, for the RAG export and for
  // debugging a shape that doesn't parse.
  rawPayload   String?
  respondedAt  DateTime        @default(now())

  @@index([taskId])
  @@index([cadreId, respondedAt])
  @@index([respondedAt])
  @@index([action])
}

// Dedup for inbound Fyxo webhook deliveries — Fyxo (like most webhook
// senders) may redeliver the same event on retry; the delivery id is the
// primary key so a second delivery of the same event is a harmless no-op
// insert failure the processor treats as "already handled".
model FyxoWebhookEvent {
  id          String    @id
  eventType   String
  // The exact JSON body Fyxo sent, kept for debugging an interaction whose
  // shape isn't fully confirmed yet (e.g. a template button tap) — without
  // this, a payload that arrives while something downstream is broken (the
  // job queue, a parser bug) is gone forever the moment this row is written.
  rawBody     Json?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

// Structured trace for every WhatsApp/AI agent operation (Part 27 of the
// spec) — which agent/tool ran, for which Cadre/assignment, with what
// confidence, so an Admin (or a future debugging session) can reconstruct
// exactly what the AI did and why, without re-reading raw LLM output.
model AgentActivityLog {
  id             String   @id @default(cuid())
  correlationId  String
  agentName      String
  toolName       String?
  userId         String?
  cadreId        String?
  taskId         String?
  conversationId String?
  messageId      String?
  intent         String?
  confidence     Float?
  model          String?
  promptVersion  String?
  input          Json?
  output         Json?
  createdAt      DateTime @default(now())

  @@index([correlationId])
  @@index([cadreId, createdAt])
}

// One row per outbound task WhatsApp message — the permanent record of what
// was sent, to whom, by whom, and whether it landed. The only store: there is
// no export step and nothing to keep in sync. The Message Log page reads it
// directly and offers a CSV download for anyone who wants a spreadsheet.
//
// Why a separate table rather than reading it off Task: a Task row holds
// only the LATEST delivery state, and is overwritten by a retry or a
// completion check, so the history of what a Cadre actually received is lost.
// It also never stores the rendered message text — the approved template
// body lives at the provider, so without this the exact words sent are
// unrecoverable.
//
// Every actor reference is a nullable FK with the name denormalised
// alongside: the log must survive a Cadre or Admin being deleted (ON DELETE
// SET NULL) and must still read correctly afterwards, which a dangling id
// alone wouldn't.
model TaskMessageLog {
  id             String   @id @default(cuid())
  cadreId        String?
  cadre          User?    @relation("MessageLogCadre", fields: [cadreId], references: [id])
  cadreName      String
  cadrePhone     String
  // The rendered body the Cadre actually reads, not the template name.
  message        String
  taskId         String?
  task           Task?    @relation(fields: [taskId], references: [id])
  taskName       String?
  // Set when this message was a poll. Poll sends go through the same log as
  // task sends so the existing button-tap capture correlates them without a
  // second pipeline — the tap router matches on the recipient's most recent
  // message, and a poll that never appeared here could never be matched.
  pollId         String?
  poll           Poll?    @relation(fields: [pollId], references: [id])
  assignedById   String?
  assignedBy     User?    @relation("MessageLogAssignedBy", fields: [assignedById], references: [id])
  assignedByName String?
  // ASSIGNMENT | RETRY | COMPLETION_CHECK | NOTIFICATION — what prompted it.
  kind           String
  templateName   String?
  channel        String
  status         String
  // The provider's id for this send, so a delivery webhook can be
  // correlated back to this exact row rather than to the Task as a whole.
  providerMessageId String?
  // Meta's own wording for why a send was refused, arriving later on a
  // message.failed webhook ("Business eligibility payment issue"). Kept
  // verbatim because it usually names the fix — without it a row reads
  // FAILED with no way to tell a billing problem from a blocked number.
  failureReason     String?
  // The exact variables this template was rendered with, in order. Stored
  // because a Resend must repeat the ORIGINAL message: re-deriving them from
  // the task would silently send different text if the task was edited, or
  // fail outright once the task is gone. Empty for a non-template (Meta
  // free-text) send, which carries its wording in `message` instead.
  variables         String[]
  // Resend bookkeeping. The row keeps its identity — status, provider id and
  // failure reason are updated in place so the log stays one line per
  // message — while every attempt is appended here:
  //   [{ at, providerMessageId, success, error }]
  retryCount        Int      @default(0)
  lastRetryAt       DateTime?
  retryHistory      Json?
  responses         TemplateResponse[]
  sentAt         DateTime @default(now())

  @@index([status, sentAt])
  @@index([sentAt])
  @@index([cadreId, sentAt])
  @@index([taskId])
  @@index([pollId])
}

// Approved WhatsApp templates pulled from the provider by the Sync button,
// so a Super Admin picks an Admin's template from a list instead of typing a
// name that only fails later at send time. A cache of someone else's data:
// wiped and rewritten on each sync, never edited here.
//
// `name` is the primary key because that is what identifies a template to
// both Meta and Fyxo — there is no separate id in a send request.
model AvailableTemplate {
  name      String   @id
  language  String
  body      String?
  // As reported by the provider (APPROVED / PENDING / REJECTED). Only
  // APPROVED templates can actually be sent, so the UI dims the others
  // rather than hiding them — a Super Admin needs to see that the template
  // they're waiting on exists but isn't usable yet.
  status    String?
  // How many {{n}} placeholders the body takes. PoliOS fills exactly one
  // (the Cadre's name), so anything else is flagged in the UI as unusable
  // rather than discovered when a send fails.
  variables Int?
  // The template's fixed quick-reply button labels ("Task Details"), which
  // Meta bakes in at approval time. Shown so a Super Admin can tell two
  // similar templates apart by what the Cadre actually taps.
  buttons   String[]
  category  String?
  // Which provider it came from, shown so a stale cache is explicable.
  source    String
  syncedAt  DateTime @default(now())
}



