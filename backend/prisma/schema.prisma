generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

// Three-tier role model. "Area" (which Region a SUPER_ADMIN/ADMIN manages) is
// expressed by User.regionId, not by the role itself — an ADMIN's regionId
// can point at a District, Constituency, Mandal, or Booth node interchangeably.
enum Role {
  SUPER_ADMIN
  ADMIN
  CADRE
}

enum RegionType {
  STATE
  DISTRICT
  CONSTITUENCY
  MANDAL
  BOOTH
}

enum CampaignStatus {
  DRAFT
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CampaignPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskAcknowledgment {
  AWAITING
  ACCEPTED
  DECLINED
}

enum ExpenseType {
  POSTER_PRINTING
  FOOD
  TRAVEL
  FUEL
  VENUE
  MISCELLANEOUS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  PDF
  VOICE_NOTE
}

enum NotificationType {
  NEW_CAMPAIGN
  TASK_ASSIGNED
  BUDGET_APPROVED
  EXPENSE_REJECTED
  DEADLINE_REMINDER
  CAMPAIGN_COMPLETED
  ESCALATION
  GRIEVANCE_SUBMITTED
  GRIEVANCE_RESOLVED
  EVENT_INVITATION
  TASK_DECLINED
  TASK_PENDING_ALLOCATION
  TASK_ALLOCATED
}

enum AIInsightType {
  SUMMARY
  RISK
  RECOMMENDATION
  PREDICTION
  WEEKLY_REPORT
}

enum GrievanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum OtpPurpose {
  PHONE_CHANGE
  PASSWORD_RESET
}

// ============================================================
// IDENTITY & HIERARCHY
// ============================================================

model User {
  id             String   @id @default(cuid())
  name           String
  phone          String   @unique
  email          String?  @unique
  passwordHash   String
  role           Role
  gender         Gender?
  profilePicture String?
  regionId       String
  region         Region   @relation(fields: [regionId], references: [id])
  parentUserId   String?
  parent         User?    @relation("UserHierarchy", fields: [parentUserId], references: [id])
  children       User[]   @relation("UserHierarchy")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  createdCampaigns    Campaign[]         @relation("CampaignCreator")
  allocationsGiven    TargetAllocation[] @relation("AllocationAssignedBy")
  allocationsOwned    TargetAllocation[] @relation("AllocationOwner")
  tasksAssignedTo     Task[]             @relation("TaskAssignee")
  tasksAssignedBy     Task[]             @relation("TaskAssigner")
  taskBatchesCreated  TaskBatch[]
  progressUpdates     ProgressUpdate[]
  expenseRequests     ExpenseRequest[]   @relation("ExpenseSubmitter")
  expenseApprovals    ExpenseRequest[]   @relation("ExpenseApprover")
  announcements       Announcement[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  citizensRegistered  Citizen[]          @relation("CitizenRegisteredBy")
  grievancesSubmitted Grievance[]        @relation("GrievanceSubmitter")
  grievancesResolved  Grievance[]        @relation("GrievanceResolver")
  eventsCreated       Event[]            @relation("EventCreator")
  eventParticipation  EventParticipant[]
  whatsAppSession     WhatsAppSession?
  otpCodes            OtpCode[]
  bulkCampaignsCreated BulkMessageCampaign[]
  fieldReports        FieldReport[]      @relation("FieldReportCadre")
}

// Verification codes for self-service flows that need proof the caller
// controls a phone number: changing to a new number, and resetting a
// forgotten password. Codes are hashed at rest (never stored plaintext),
// short-lived, single-use, and attempt-limited to resist brute force.
model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose, phone])
}

// Tracks where a Cadre is in the WhatsApp conversation flow (main menu,
// mid-way through registering a citizen, awaiting a progress %, ...) so a
// stateless webhook can resume a multi-step exchange across messages.
model WhatsAppSession {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  state     String   @default("MAIN")
  context   Json?
  updatedAt DateTime @updatedAt
}

model Region {
  id       String     @id @default(cuid())
  name     String
  type     RegionType
  parentId String?
  parent   Region?    @relation("RegionHierarchy", fields: [parentId], references: [id])
  children Region[]   @relation("RegionHierarchy")

  users          User[]
  allocations    TargetAllocation[]
  citizens       Citizen[]
  grievances     Grievance[]
  events         Event[]
  bulkRecipients BulkRecipient[]
}

// ============================================================
// CAMPAIGN
// ============================================================

model Campaign {
  id                 String           @id @default(cuid())
  name               String
  description        String
  objective          String?
  category           String?
  startDate          DateTime
  endDate            DateTime
  priority           CampaignPriority @default(MEDIUM)
  status             CampaignStatus   @default(DRAFT)
  bannerUrl          String?
  totalTarget        Int
  totalBudget        Decimal          @db.Decimal(14, 2)
  expectedVolunteers Int?
  requiredDocuments  String[]
  createdById        String
  createdBy          User             @relation("CampaignCreator", fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  attachments   CampaignAttachment[]
  allocations   TargetAllocation[]
  tasks         Task[]
  taskBatches   TaskBatch[]
  expenses      ExpenseRequest[]
  announcements Announcement[]
  aiInsights    AIInsight[]

  @@index([status, priority])
}

model CampaignAttachment {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  url        String
  fileType   String
  uploadedAt DateTime @default(now())
}

// Hierarchical target + budget split: State -> District -> Mandal -> Booth -> Cadre.
// Each row's parentAllocationId points to the allocation it was split from,
// so the tree mirrors the org hierarchy exactly.
model TargetAllocation {
  id                 String             @id @default(cuid())
  campaignId         String
  campaign           Campaign           @relation(fields: [campaignId], references: [id])
  regionId           String
  region             Region             @relation(fields: [regionId], references: [id])
  ownerUserId        String
  ownerUser          User               @relation("AllocationOwner", fields: [ownerUserId], references: [id])
  assignedById       String
  assignedBy         User               @relation("AllocationAssignedBy", fields: [assignedById], references: [id])
  parentAllocationId String?
  parentAllocation   TargetAllocation?  @relation("AllocationHierarchy", fields: [parentAllocationId], references: [id])
  childAllocations   TargetAllocation[] @relation("AllocationHierarchy")

  target        Int
  achievedCount Int      @default(0)
  deadline      DateTime
  notes         String?

  allocatedBudget Decimal @db.Decimal(14, 2)
  approvedBudget  Decimal @default(0) @db.Decimal(14, 2)
  spentBudget     Decimal @default(0) @db.Decimal(14, 2)
  // remainingBudget = allocatedBudget - spentBudget, computed in the service layer

  createdAt DateTime @default(now())

  tasks    Task[]
  expenses ExpenseRequest[]

  @@index([campaignId, regionId])
}

// ============================================================
// TASKS & PROGRESS
// ============================================================

// One "Create Task" submission that fans out to every Cadre under the
// selected District(s)/Mandal(s)/Booth(s) — one Task row per resolved
// Cadre (see TasksService.createBatch), grouped here so the Task
// Intelligence Dashboard can show rollup stats without a single Task
// trying to represent more than one assignee.
model TaskBatch {
  id                String       @id @default(cuid())
  name              String
  objective         String?
  description       String?
  additionalDetails String?
  remarks           String?
  deadline          DateTime
  priority          TaskPriority @default(MEDIUM)
  campaignId        String?
  campaign          Campaign?    @relation(fields: [campaignId], references: [id])
  targetRegionIds   String[] // the District/Mandal/Booth selection, kept for audit/display
  attachmentUrls    String[]
  createdById       String
  createdBy         User         @relation(fields: [createdById], references: [id])
  createdAt         DateTime     @default(now())
  // True only for a SUPER_ADMIN-created batch: no Task rows are created yet —
  // it's routed to whichever Admins cover targetRegionIds, and each Admin
  // allocates it to their own Cadres (TasksService.allocateToCadres), which
  // is what actually creates the Task rows below. An ADMIN-created batch
  // fans out to Cadres immediately, same as before, so this stays false.
  awaitingAllocation Boolean     @default(false)

  tasks      Task[]
  aiInsights AIInsight[]
}

enum WhatsappDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Task {
  id                String                 @id @default(cuid())
  campaignId        String?
  campaign          Campaign?              @relation(fields: [campaignId], references: [id])
  allocationId      String?
  allocation        TargetAllocation?      @relation(fields: [allocationId], references: [id])
  batchId           String?
  batch             TaskBatch?             @relation(fields: [batchId], references: [id])
  name              String
  objective         String?
  description       String?
  additionalDetails String?
  assignedToId      String
  assignedTo        User                   @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedById      String
  assignedBy        User                   @relation("TaskAssigner", fields: [assignedById], references: [id])
  deadline          DateTime
  priority          TaskPriority           @default(MEDIUM)
  status            TaskStatus             @default(PENDING)
  remarks           String?
  acknowledgment    TaskAcknowledgment     @default(AWAITING)
  acknowledgedAt    DateTime?
  needsReassignment Boolean                @default(false)
  // Per-Cadre WhatsApp delivery outcome for this allocation — set when
  // allocateToCadres() sends the assignment message, retried independently
  // via retryWhatsapp() if it failed. Deliberately lives on Task (one row
  // per assigned Cadre) rather than a separate table, since Task already
  // *is* the per-Cadre allocation record. whatsappMessageId correlates
  // Meta's delivered/read status webhook callbacks back to this row (see
  // WhatsAppWebhookController + TasksService.handleWhatsappStatusUpdate).
  whatsappStatus    WhatsappDeliveryStatus @default(PENDING)
  whatsappMessageId String?
  // Correlates a Fyxo-sent interactive assignment message's delivery-status
  // webhook back to this row — distinct from whatsappMessageId (Meta's
  // wamid) since a Task can only have been sent through one channel or the
  // other for its assignment message, never both (see NotificationsService).
  fyxoMessageId     String?
  // Which Fyxo template the assignment message actually went out as (e.g.
  // "polios") — kept alongside fyxoMessageId so a later webhook-driven
  // interaction (a button tap) can be traced back to exactly what was sent,
  // and so this stays meaningful once more than one approved template exists.
  fyxoTemplateName  String?
  whatsappSentAt    DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  // First time this Task's progress hit 100% — set once, kept stable across
  // any later re-submission, so "average completion time" reflects the
  // actual first completion rather than a resubmit timestamp.
  completedAt       DateTime?
  createdAt         DateTime               @default(now())

  attachments  TaskAttachment[]
  progress     ProgressUpdate[]
  fieldReports FieldReport[]

  @@index([assignedToId, status])
  @@index([whatsappMessageId])
  @@index([fyxoMessageId])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  url       String
  fileType  String
  createdAt DateTime @default(now())
}

model ProgressUpdate {
  id                   String   @id @default(cuid())
  taskId               String
  task                 Task     @relation(fields: [taskId], references: [id])
  // Optional (not required) so a field report survives its Cadre being
  // deleted — the report content is real field data, not the deleted
  // account's property, and reassigning it to whoever did the deleting
  // would misattribute who actually did the work. See UsersService.remove().
  cadreId              String?
  cadre                User?    @relation(fields: [cadreId], references: [id])
  completedForms       Int?
  meetingsConducted    Int?
  houseVisits          Int?
  volunteersJoined     Int?
  photos               String[]
  videos               String[]
  gpsLat               Float?
  gpsLng               Float?
  completionPercentage Int
  createdAt            DateTime @default(now())
}

// ============================================================
// BUDGET & EXPENSES
// ============================================================

model ExpenseRequest {
  id              String            @id @default(cuid())
  campaignId      String
  campaign        Campaign          @relation(fields: [campaignId], references: [id])
  allocationId    String?
  allocation      TargetAllocation? @relation(fields: [allocationId], references: [id])
  submittedById   String
  submittedBy     User              @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  expenseType     ExpenseType
  amount          Decimal           @db.Decimal(12, 2)
  billUrl         String?
  description     String?
  approvalStatus  ApprovalStatus    @default(PENDING)
  approvedById    String?
  approvedBy      User?             @relation("ExpenseApprover", fields: [approvedById], references: [id])
  rejectionReason String?
  createdAt       DateTime          @default(now())
  decidedAt       DateTime?

  @@index([campaignId, approvalStatus])
}

// ============================================================
// COMMUNICATION & NOTIFICATIONS
// ============================================================

model Announcement {
  id              String      @id @default(cuid())
  campaignId      String?
  campaign        Campaign?   @relation(fields: [campaignId], references: [id])
  senderId        String
  sender          User        @relation(fields: [senderId], references: [id])
  targetLevels    Role[]
  targetRegionIds String[]
  messageType     MessageType
  content         String
  mediaUrl        String?
  createdAt       DateTime    @default(now())
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  type              NotificationType
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean          @default(false)
  createdAt         DateTime         @default(now())

  @@index([userId, isRead])
}

// ============================================================
// BULK WHATSAPP MESSAGING (via Fyxo Connect)
// ============================================================

enum BulkCampaignStatus {
  DRAFT // recipients uploaded, message/selection still being set up
  SENDING // dispatch calls to Fyxo Connect in progress
  SENT // every selected recipient has been handed off to Fyxo Connect
  FAILED // the dispatch call to Fyxo Connect failed outright
}

enum BulkRecipientStatus {
  PENDING // selected, not yet dispatched
  SENT // handed off to Fyxo Connect
  DELIVERED
  READ
  FAILED
  OPTED_OUT
}

// One Excel upload = one campaign. Recipients are parsed once at upload
// time (see BulkMessagingService.parseAndValidate) and never re-derived —
// this row tracks the message content and roll-up counts; BulkRecipient
// rows below are the actual send list and per-contact delivery state.
model BulkMessageCampaign {
  id             String             @id @default(cuid())
  name           String
  messageText    String?
  mediaUrl       String?
  templateId     String? // optional Fyxo Connect template reference, once that contract is known
  status         BulkCampaignStatus @default(DRAFT)
  totalContacts  Int                @default(0)
  validCount     Int                @default(0)
  invalidCount   Int                @default(0)
  duplicateCount Int                @default(0)
  createdById    String
  createdBy      User               @relation(fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  sentAt         DateTime?

  recipients BulkRecipient[]

  @@index([status])
}

// One row per Excel row. District/Constituency/Mandal/Booth are kept as the
// raw text from the file (source of truth for filtering — an uploaded
// contact list won't always match Region spelling exactly) AND
// best-effort-resolved against the real Region table into regionId, so a
// row that does match gets the benefit of the real hierarchy where useful.
model BulkRecipient {
  id                String               @id @default(cuid())
  campaignId        String
  campaign          BulkMessageCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name              String?
  phone             String // normalized, digits-only
  rawPhone          String // exactly as uploaded, for audit/debugging
  districtName      String?
  constituencyName  String?
  mandalName        String?
  boothName         String?
  regionId          String?
  region            Region?              @relation(fields: [regionId], references: [id])
  isValidPhone      Boolean              @default(true)
  isDuplicate       Boolean              @default(false)
  selected          Boolean              @default(true)
  status            BulkRecipientStatus  @default(PENDING)
  providerMessageId String? // Fyxo Connect's id for this send, for webhook correlation
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedReason      String?
  createdAt         DateTime             @default(now())

  @@index([campaignId, status])
  @@index([campaignId, selected])
  @@index([providerMessageId])
}

// ============================================================
// AI & AUDIT
// ============================================================

model AIInsight {
  id          String        @id @default(cuid())
  campaignId  String?
  campaign    Campaign?     @relation(fields: [campaignId], references: [id])
  taskBatchId String?
  taskBatch   TaskBatch?    @relation(fields: [taskBatchId], references: [id])
  type        AIInsightType
  regionId    String?
  content     String
  metadata    Json?
  generatedAt DateTime      @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  // Optional so an audit entry survives its actor being deleted — an audit
  // log records a historical fact about who did something; reassigning
  // that FK to whoever performed the deletion would falsify the record
  // instead of preserving it. See UsersService.remove().
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ============================================================
// CITIZEN REGISTRATION & GRIEVANCES
// ============================================================
// Citizens are data records maintained by Cadres/Admins — citizens never
// log into the platform themselves. There is no citizen-facing surface.

model Citizen {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  address        String?
  regionId       String
  region         Region   @relation(fields: [regionId], references: [id])
  registeredById String
  registeredBy   User     @relation("CitizenRegisteredBy", fields: [registeredById], references: [id])
  createdAt      DateTime @default(now())

  grievances Grievance[]

  @@index([regionId])
}

model Grievance {
  id              String          @id @default(cuid())
  citizenId       String?
  citizen         Citizen?        @relation(fields: [citizenId], references: [id])
  regionId        String
  region          Region          @relation(fields: [regionId], references: [id])
  submittedById   String
  submittedBy     User            @relation("GrievanceSubmitter", fields: [submittedById], references: [id])
  category        String
  description     String
  photos          String[]
  status          GrievanceStatus @default(OPEN)
  resolutionNotes String?
  resolvedById    String?
  resolvedBy      User?           @relation("GrievanceResolver", fields: [resolvedById], references: [id])
  createdAt       DateTime        @default(now())
  resolvedAt      DateTime?

  @@index([regionId, status])
}

// ============================================================
// EVENTS & ATTENDANCE
// ============================================================

model Event {
  id                String    @id @default(cuid())
  name              String
  description       String?
  objective         String?
  location          String?
  organizer         String?
  instructions      String?
  remarks           String? // "Comments" on the detail page, and "Event Issues/Remarks" on the dashboard
  expectedAttendees Int?
  attachmentUrls    String[]  @default([])
  regionId          String
  region            Region    @relation(fields: [regionId], references: [id])
  startAt           DateTime
  endAt             DateTime?
  createdById       String
  createdBy         User      @relation("EventCreator", fields: [createdById], references: [id])
  createdAt         DateTime  @default(now())

  participants EventParticipant[]

  @@index([regionId, startAt])
}

enum EventRsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model EventParticipant {
  id          String          @id @default(cuid())
  eventId     String
  event       Event           @relation(fields: [eventId], references: [id])
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  rsvpStatus  EventRsvpStatus @default(PENDING)
  attended    Boolean         @default(false)
  checkedInAt DateTime?

  @@unique([eventId, userId])
}

// ============================================================
// FIELD INTELLIGENCE (WhatsApp/AI agent layer, via Fyxo Connect)
// ============================================================

enum FieldReportSource {
  CADRE_VOICE_REPORT
  CADRE_TEXT_REPORT
  CADRE_PHOTO_REPORT
  CADRE_DOCUMENT_REPORT
}

// SUBMITTED -> NEEDS_REVIEW (low-confidence extraction) or straight to
// VERIFIED once an Admin has looked at it. Deliberately NOT modeled as a
// new Task.status value — Task's existing status/acknowledgment enums are
// read by every dashboard already built; this layers the verification
// workflow on the FieldReport itself instead of widening Task's enum.
enum FieldReportReviewStatus {
  SUBMITTED
  NEEDS_REVIEW
  VERIFIED
}

// One row per piece of unstructured field intelligence (voice/text/photo/
// document) a Cadre sends on WhatsApp, produced by FieldIntelligenceAgent.
// taskId is nullable — a Cadre can send a field report that isn't tied to
// any specific assignment (e.g. an unprompted issue report).
model FieldReport {
  id                 String                   @id @default(cuid())
  taskId             String?
  task               Task?                    @relation(fields: [taskId], references: [id])
  // Optional for the same reason as ProgressUpdate.cadreId — preserve the
  // report itself without misattributing it if the Cadre is later deleted.
  cadreId            String?
  cadre              User?                    @relation("FieldReportCadre", fields: [cadreId], references: [id])
  source             FieldReportSource
  rawMediaUrl        String?
  originalTranscript String?
  detectedLanguage   String?
  normalizedText     String?
  // Structured extraction, e.g. { region, householdsVisited, ... } — shape
  // varies by report content, so JSON rather than fixed columns.
  extractedData      Json?
  // Array of { category, affectedHouseholds?, duration?, confidence, ... }
  issues             Json?
  // Overall extraction confidence (0-1). Individual field confidences live
  // inside extractedData/issues themselves (see Part 16 of the spec).
  confidence         Float?
  reviewStatus       FieldReportReviewStatus @default(SUBMITTED)
  evidenceUrls       String[]                @default([])
  createdAt          DateTime                @default(now())

  @@index([taskId])
  @@index([cadreId])
  @@index([reviewStatus])
}

// Dedup for inbound Fyxo webhook deliveries — Fyxo (like most webhook
// senders) may redeliver the same event on retry; the delivery id is the
// primary key so a second delivery of the same event is a harmless no-op
// insert failure the processor treats as "already handled".
model FyxoWebhookEvent {
  id          String    @id
  eventType   String
  // The exact JSON body Fyxo sent, kept for debugging an interaction whose
  // shape isn't fully confirmed yet (e.g. a template button tap) — without
  // this, a payload that arrives while something downstream is broken (the
  // job queue, a parser bug) is gone forever the moment this row is written.
  rawBody     Json?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

// Structured trace for every WhatsApp/AI agent operation (Part 27 of the
// spec) — which agent/tool ran, for which Cadre/assignment, with what
// confidence, so an Admin (or a future debugging session) can reconstruct
// exactly what the AI did and why, without re-reading raw LLM output.
model AgentActivityLog {
  id             String   @id @default(cuid())
  correlationId  String
  agentName      String
  toolName       String?
  userId         String?
  cadreId        String?
  taskId         String?
  conversationId String?
  messageId      String?
  intent         String?
  confidence     Float?
  model          String?
  promptVersion  String?
  input          Json?
  output         Json?
  createdAt      DateTime @default(now())

  @@index([correlationId])
  @@index([cadreId, createdAt])
}
