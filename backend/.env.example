# Postgres (used by prisma + this API)
DATABASE_URL="postgresql://polios:polios@localhost:5432/polios?schema=public"

# Redis (BullMQ queues + cache)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"

# AI (Claude)
ANTHROPIC_API_KEY=""

# WhatsApp Business Cloud API (Meta) — leave blank to run without WhatsApp;
# sends are skipped and logged instead of failing. See README for how to get
# real values (Meta Developer account, WhatsApp product, temp test number).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="polios-verify-token"
WHATSAPP_API_VERSION="v20.0"

# File storage (S3-compatible) — not wired up yet, WhatsApp media currently
# saves to local disk (uploads/) instead
S3_ENDPOINT=""
S3_BUCKET="polios-uploads"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
