# Postgres (used by prisma + this API)
DATABASE_URL="postgresql://polios:polios@localhost:5432/polios?schema=public"

# Redis (BullMQ queues + cache)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API
API_PORT=4000
# Comma-separated for more than one allowed front-end origin.
CORS_ORIGIN="http://localhost:3000"

# AI (Claude)
ANTHROPIC_API_KEY=""

# WhatsApp Business Cloud API (Meta) — leave blank to run without WhatsApp;
# sends are skipped and logged instead of failing. See README for how to get
# real values (Meta Developer account, WhatsApp product, temp test number).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="polios-verify-token"
WHATSAPP_API_VERSION="v20.0"

# File storage (S3-compatible) — not wired up yet, WhatsApp media currently
# saves to local disk (uploads/) instead
S3_ENDPOINT=""
S3_BUCKET="polios-uploads"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Fyxo Connect WhatsApp (Cadre agent layer) — leave blank to run without it;
# sends are skipped/logged and webhook signature checks are bypassed with a
# loud warning, same "simulate when unconfigured" pattern as the Meta
# integration above. Base URL is fixed per the documented contract.
# FYXO_API_KEY is the only credential Fyxo's auth actually requires (Bearer
# token) — set it to flip sending on. FYXO_WEBHOOK_SECRET verifies inbound
# webhooks (Cadre replies, delivery status); safe to leave blank while
# testing, but every webhook is accepted unverified until it's set.
FYXO_API_KEY=""
FYXO_WEBHOOK_SECRET=""
FYXO_BASE_URL="https://api.connect.fyxo.ai/api"
# Only set this if Fyxo tells you the path to their template-listing
# endpoint — as of 2026-09-10 their API exposes none, so the "Sync templates"
# button falls back to Meta. See TemplateSyncService.
FYXO_TEMPLATES_PATH=""

# WhatsApp Business Account ID — only needed for "Sync templates" (Meta's
# GET /{waba_id}/message_templates). Find it in Meta Business Suite ->
# WhatsApp Accounts, or the Meta app dashboard's WhatsApp page. Works with
# WHATSAPP_ACCESS_TOKEN above; templates live in Meta whichever BSP delivers
# them, so the names it returns are the ones Fyxo sends with.
WHATSAPP_WABA_ID=""

# Speech-to-text for Cadre voice reports (OpenAI Whisper API) — leave blank
# to run without it; voice reports are stored but not transcribed/extracted.
OPENAI_API_KEY=""

# Google Sheets — every task-related WhatsApp send (assignment, retry,
# completion check) is logged as a row (Name, Number, Message, Status,
# Sent At). Leave blank to run without it; sends are logged instead of
# appended.
#
# WHICH sheet is NOT configured here — a Super Admin connects it in the app
# (Google Sheet page -> Connect Sheet) and can repoint it any time; it's
# stored in the SheetConnection table. These two values are only the
# *credential* that does the writing, set once per deploy. It's a Google
# Cloud service account (not anyone's personal Google login):
#   1. console.cloud.google.com -> a project -> APIs & Services -> Library
#      -> enable "Google Sheets API"
#   2. APIs & Services -> Credentials -> Create Credentials -> Service
#      Account -> create it, then Keys -> Add Key -> JSON -> download it
#   3. Open the downloaded JSON: GOOGLE_SHEETS_CLIENT_EMAIL is its
#      "client_email", GOOGLE_SHEETS_PRIVATE_KEY is its "private_key"
#      (keep the \n escapes exactly as in the file, wrapped in quotes here)
# The Super Admin then shares their sheet with that client_email as an
# Editor — the app shows them the address, and Connect Sheet fails with
# exactly that instruction if they haven't.
GOOGLE_SHEETS_CLIENT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""
